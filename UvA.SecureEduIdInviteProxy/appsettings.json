{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    }
  }, 
  "AllowedHosts": "*",
  "EduId" : {
    "InvitationApiUrl": "<surfcontext-api-url>",
    "InvitationApiToken": "<surfconext-token>",
    "RoleIds" : {
      "ThesisMatching": "<role-id>",
      "Milestones": "<role-id>"
    },
    "RoleTokens": {
      "ThesisMatching": "<api-token>",
      "Milestones": "<api-token>"
    }
  }
}
