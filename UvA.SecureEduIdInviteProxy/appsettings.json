{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SecureEduInviteProxy": "Debug"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "SecureEduInviteProxy": "Debug"
      },
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    }
  },
  "AllowedHosts": "*",
  "EduId" : {
  "InvitationApiUrl": "https://invite.test.surfconext.nl",
  "InvitationApiToken": "<token>"
  },
  "RoleApiTokens" : {
    "2412": "<token>"
  },
  "AzureMonitor": {
    "ConnectionString": "",
    "EnableAuditLogging": true
  }
}
